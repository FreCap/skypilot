# Boltz image: build and install the full fork package on top of the pinned
# upstream runtime base. Installing a wheel (instead of copying only sky/)
# keeps Python distribution metadata and runtime source on the same version.
ARG BASE_IMAGE=berkeleyskypilot/skypilot-nightly:1.0.0.dev20260620
FROM ${BASE_IMAGE} AS wheel-builder
WORKDIR /tmp/skypilot
COPY setup.py pyproject.toml MANIFEST.in README.md ./
COPY root_py_modules/ ./
COPY sky/ sky/
COPY sky_templates/ sky_templates/
COPY boltz/reserved_fill_reclaim_policy/ /tmp/reserved-fill-reclaim-policy/
# The base runtime installs the nightly distribution name. Build the fork with
# that same name so pip replaces its files and dist-info atomically.
RUN sed -i "s/name='skypilot',/name='skypilot-nightly',/" setup.py && \
    python -m pip wheel --no-deps --no-build-isolation \
      --wheel-dir /tmp/skypilot-wheels . && \
    python -m pip wheel --no-deps --no-build-isolation \
      --wheel-dir /tmp/policy-wheels /tmp/reserved-fill-reclaim-policy

FROM ${BASE_IMAGE}
ARG SKYPILOT_VERSION
ARG SKYPILOT_COMMIT_SHA
LABEL org.opencontainers.image.version="${SKYPILOT_VERSION}" \
      org.opencontainers.image.revision="${SKYPILOT_COMMIT_SHA}"
COPY --from=wheel-builder /tmp/skypilot-wheels/*.whl /tmp/skypilot-wheels/
COPY --from=wheel-builder /tmp/policy-wheels/*.whl /tmp/policy-wheels/
RUN python -m pip install --no-cache-dir --no-deps --force-reinstall \
      /tmp/skypilot-wheels/*.whl /tmp/policy-wheels/*.whl && \
    rm -rf /tmp/skypilot-wheels /tmp/policy-wheels
