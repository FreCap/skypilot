# boltz overlay image: layer this fork's changed runtime files onto the pinned
# upstream skypilot-nightly base. The build context is assembled by
# build-overlay.sh to contain the files that differ from the fork base
# (git diff <fork-base> HEAD -- 'sky/**') PLUS any fork sky/ module the base
# image is missing, so a single recursive COPY overlays exactly the files the
# fork needs without shadowing base files the diff leaves to the newer wheel.
ARG BASE_IMAGE=berkeleyskypilot/skypilot-nightly:1.0.0.dev20260620
FROM ${BASE_IMAGE}
COPY sky/ /usr/local/lib/python3.10/site-packages/sky/
